{
  "name": "swire-desktop-assistant",
  "version": "0.1.0",
  "description": "A local-first Windows desktop companion",
  "main": "dist-electron/electron/main.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.electron.json && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env SWIRE_DEV=1 electron .\"",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:ui": "playwright test",
    "dist:win": "npm run build && node scripts/package-windows.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:win": "npm run build && node scripts/package-windows.mjs --unpacked",
    "runtime:install": "node node_modules/electron/install.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zehsong/swire-desktop-assistant.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Zehsong/swire-desktop-assistant/issues"
  },
  "homepage": "https://github.com/Zehsong/swire-desktop-assistant#readme",
  "private": true,
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.10.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "wait-on": "^9.5.1",
    "@electron/get": "^5.1.0",
    "@electron-internal/extract-zip": "^1.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
